{
  "name": "MoneyHero",
  "productName": "Money Hero",
  "type": "module",
  "version": "1.0.0",
  "description": "Money Hero is a desktop portfolio dashboard, not a bank or trading app",
  "author": "MiskaMyasa",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Miskamyasa/money-hero.git"
  },
  "bugs": {
    "url": "https://github.com/Miskamyasa/money-hero/issues"
  },
  "homepage": "https://github.com/Miskamyasa/money-hero",
  "main": "./out/main/index.js",
  "scripts": {
    "lint": "eslint --cache",
    "lint:fix": "eslint --cache --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && npx @electron/rebuild --only better-sqlite3",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:mac": "pnpm run build && electron-builder --mac"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@mantine/core": "9.1.0",
    "@mantine/hooks": "9.1.0",
    "@mantine/notifications": "9.1.0",
    "better-sqlite3": "12.9.0",
    "knex": "3.2.9",
    "mobx": "6.15.0",
    "mobx-react-lite": "4.1.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@electron/rebuild": "4.0.4",
    "@miskamyasa/eslint-config": "^1.0.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "41.2.2",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "eslint": "10.2.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "postcss": "8.5.10",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "5.9.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "vite": "8.0.9"
  }
}
